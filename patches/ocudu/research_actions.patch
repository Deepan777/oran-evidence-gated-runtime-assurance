+error_type<std::string> research_action_remote_command::execute(const nlohmann::json& json)
+{
+  auto action_key = json.find("action");
+  if (action_key == json.end()) {
+    return make_unexpected("'action' is mandatory (A0, A1, A2, A3, or A4)");
+  }
+
+  int action_value = -1;
+  if (action_key->is_string()) {
+    const std::string value = action_key->get<std::string>();
+    if (value.size() == 2 and value[0] == 'A' and value[1] >= '0' and value[1] <= '4') {
+      action_value = value[1] - '0';
+    }
+  } else if (action_key->is_number_integer()) {
+    action_value = action_key->get<int>();
+  }
+  if (action_value < 0 or action_value > 4) {
+    return make_unexpected("'action' must be A0..A4 or integer 0..4");
+  }
+
+  research_action_state state;
+  state.action = static_cast<research_action_id>(action_value);
+
+  auto read_unsigned = [&json](const char* name, unsigned default_value) -> expected<unsigned, std::string> {
+    auto item = json.find(name);
+    if (item == json.end()) {
+      return default_value;
+    }
+    if (!item->is_number_unsigned()) {
+      return make_unexpected(fmt::format("'{}' must be an unsigned integer", name));
+    }
+    return item->get<unsigned>();
+  };
+
+  auto prb_start = read_unsigned("prb_start", state.prb_start);
+  auto prb_stop  = read_unsigned("prb_stop", state.prb_stop);
+  auto mcs_cap   = read_unsigned("mcs_cap", state.mcs_cap);
+  auto slice_min = read_unsigned("slice_min_pct", state.slice_min_pct);
+  auto slice_max = read_unsigned("slice_max_pct", state.slice_max_pct);
+  if (!prb_start || !prb_stop || !mcs_cap || !slice_min || !slice_max) {
+    return make_unexpected("research action parameter has an invalid type");
+  }
+
+  state.prb_start     = static_cast<uint16_t>(prb_start.value());
+  state.prb_stop      = static_cast<uint16_t>(prb_stop.value());
+  state.mcs_cap       = static_cast<uint8_t>(mcs_cap.value());
+  state.slice_min_pct = static_cast<uint8_t>(slice_min.value());
+  state.slice_max_pct = static_cast<uint8_t>(slice_max.value());
+
+  if (research_action_control::prb_control_enabled(state) and
+      (prb_start.value() >= prb_stop.value() or prb_stop.value() > 275U)) {
+    return make_unexpected("A1/A4 require 0 <= prb_start < prb_stop <= 275");
+  }
+  if (research_action_control::mcs_control_enabled(state) and mcs_cap.value() > 28U) {
+    return make_unexpected("A2/A4 require 0 <= mcs_cap <= 28");
+  }
+  if (research_action_control::slice_control_enabled(state) and
+      (slice_min.value() > slice_max.value() or slice_max.value() > 100U)) {
+    return make_unexpected("A3 requires 0 <= slice_min_pct <= slice_max_pct <= 100");
+  }
+
+  state = research_action_control::publish(state);
+  std::printf("RESEARCH_ACTION_APPLIED generation=%u action=A%d prb=[%u,%u) mcs_cap=%u slice=[%u,%u]%%\n",
+              state.generation,
+              action_value,
+              state.prb_start,
+              state.prb_stop,
+              state.mcs_cap,
+              state.slice_min_pct,
+              state.slice_max_pct);
+  std::fflush(stdout);
+  return {};
+}
