+/// Lock-free research control for action-explainable anti-jamming experiments.
+class research_action_remote_command : public app_services::remote_command
+{
+public:
+  std::string_view get_name() const override { return "research_action_set"; }
+
+  std::string_view get_description() const override
+  {
+    return "Atomically applies A0-A4 scheduler research actions";
+  }
+
+  error_type<std::string> execute(const nlohmann::json& json) override;
+};
