diff --git a/lib/scheduler/ue_context/ue_link_adaptation_controller.cpp b/lib/scheduler/ue_context/ue_link_adaptation_controller.cpp
--- a/lib/scheduler/ue_context/ue_link_adaptation_controller.cpp
+++ b/lib/scheduler/ue_context/ue_link_adaptation_controller.cpp
@@ -108,9 +108,22 @@ std::optional<sch_mcs_index> ue_link_adaptation_controller::calculate_dl_mcs(pdsc
 {
   const research_action_state action = research_action_control::load();
