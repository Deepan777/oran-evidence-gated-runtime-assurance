-    return research_action_control::mcs_control_enabled(action)
-               ? sch_mcs_index{static_cast<uint8_t>(std::min<unsigned>(mcs.value(), action.mcs_cap))}
-               : mcs;
+    if (not research_action_control::mcs_control_enabled(action)) {
+      return mcs;
+    }
+    const sch_mcs_index capped{static_cast<uint8_t>(std::min<unsigned>(mcs.value(), action.mcs_cap))};
+    static std::atomic<uint16_t> last_logged_generation{0};
+    uint16_t expected = last_logged_generation.load(std::memory_order_relaxed);
