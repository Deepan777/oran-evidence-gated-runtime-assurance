# Project-local environments and caches
.cache/
.tmp/
.codex-tools/
envs/

# External source/build trees are pinned through environment.lock, not vendored.
external/*/
!external/.gitkeep
software/wsl/
software/downloads/
oran_cloud_bundle.zip
oran_cloud_bundle_fixed.zip
oran_cloud_bundle_py311.zip
cloud_bundle_stage/
third_party/

# Generated data, logs, models, and results
data/raw/
data/interim/
data/processed/
datasets/raw/
datasets/interim/
datasets/processed/
logs/
checkpoints/
models/detector/
models/controller/
results/raw/
results/aggregate/
results/processed/
results/statistics/
results/statistical/
results/xai/
results/figures/
results/tables/

# Preserve manifests and placeholders
!data/**/.gitkeep
!datasets/**/.gitkeep
!logs/.gitkeep
!checkpoints/.gitkeep
!models/**/.gitkeep
!results/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# IDE/OS
.vscode/
.idea/
Thumbs.db
desktop.ini
